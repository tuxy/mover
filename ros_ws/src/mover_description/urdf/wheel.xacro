<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- The front roller -->
<joint name="roller_joint" type="fixed">
        <parent link="base_link"/>
        <child link="roller_link"/>
        <origin xyz="0 -0.12 -0.04" rpy="0 0 0"/>
</joint>
<link name="roller_link">
        <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                        <sphere radius="0.02"/>
                </geometry>
                <material name="black">
                        <color rgba="0 0 0 1"/>
                </material>
        </visual>
        <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                        <sphere radius="0.02"/>
                </geometry>
        </collision>
        <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.1"/>
                <inertia ixx="0.0082" ixy="0.0" ixz="0.0" iyy="0.0082" iyz="0.0" izz="0.0154" />
        </inertial>
</link>

<!-- Wheel Macro -->
<xacro:macro name="wheel" params="side reflect">
        <joint name="wheel_${side}_joint" type="continuous">
                <parent link="base_link"/>
                <child link="wheel_${side}_link"/>
                <origin xyz="${reflect*0.11} 0 -0.03" rpy="0 1.57075 0"/>
                <axis xyz="0 0 1"/>
        </joint>
        <link name="wheel_${side}_link">
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0"/>
                        <geometry>
                                <cylinder length="0.016" radius="0.033"/>
                        </geometry>
                        <material name="black">
                                <color rgba="0 0 0 1"/>
                        </material>
                </visual>
                <collision>
                        <origin xyz="0 0 0" rpy="0 0 0"/>
                        <geometry>
                                <cylinder length="0.016" radius="0.033"/>
                        </geometry>
                </collision>
                <inertial>
                        <origin xyz="0 0 0" rpy="0 0 0"/>
                        <mass value="0.2"/>
                        <inertia ixx="0.0082" ixy="0.0" ixz="0.0" iyy="0.0082" iyz="0.0" izz="0.0154" />
                </inertial>
        </link>
</xacro:macro>
<xacro:wheel side="right" reflect="-1"/>
<xacro:wheel side="left" reflect="1"/>

</robot>
